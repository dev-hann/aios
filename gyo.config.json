{
  "name": "AIOS",
  "version": "3.0.0",
  "profiles": {
    "development": {
      "serverUrl": "http://192.168.0.7:3000"
    },
    "production": {
      "serverUrl": "https://aios.app"
    }
  },
  "platforms": {
    "android": {
      "enabled": true,
      "packageName": "com.agent.aios"
    },
    "ios": {
      "enabled": false
    }
  },
  "webview": {
    "allowFileAccess": false,
    "allowUniversalAccessFromFileURLs": false,
    "userAgent": "aios-webview/3.0"
  },
  "script": {
    "start": "npm run dev"
  }
}
