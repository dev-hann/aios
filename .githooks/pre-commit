#!/bin/bash

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "[pre-commit] Running flutter analyze..."

cd "$REPO_ROOT"
flutter analyze --no-fatal-infos --no-fatal-warnings 2>&1 | tail -5

if [ ${PIPESTATUS[0]} -ne 0 ]; then
    echo "[pre-commit] flutter analyze failed."
    exit 1
fi

echo "[pre-commit] Analyze passed."
exit 0
